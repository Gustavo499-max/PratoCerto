# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" para o GitHub (ele já está no .gitignore).

# Conexão com o PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/pratocerto"

# Chave usada para assinar e validar os tokens JWT.
# Troque por uma string longa e aleatória antes de usar em produção.
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria"

# Porta em que a API vai rodar
PORT=3000
